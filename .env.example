# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: For guild-specific command registration (faster for testing)
DISCORD_GUILD_ID=your_guild_id_here

# Channel where heist submissions are sent for staff review
REVIEW_CHANNEL_ID=your_review_channel_id_here

# Role ID required to approve/reject heist submissions
ADMIN_ROLE_ID=your_admin_role_id_here

# Set to 'true' to enable verbose debug logging
DEBUG=false
