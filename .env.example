# ─────────────────────────────────────────────────────────────────────────────
# GTA HEIST RPG BOT — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Discord bot token — from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# [REQUIRED] Application/Client ID — from the Developer Portal
DISCORD_CLIENT_ID=your_application_client_id_here

# [OPTIONAL] Guild ID for instant slash command registration (dev only)
# Omit for global commands (takes up to 1 hour to propagate)
DISCORD_GUILD_ID=your_guild_id_here

# [OPTIONAL] The channel ID where heist submissions are posted for staff review
# Without this, submissions are saved to DB but not posted anywhere
REVIEW_CHANNEL_ID=your_review_channel_id_here

# [OPTIONAL] Role ID required to click Approve/Reject on submissions
# If not set, anyone can approve/reject
ADMIN_ROLE_ID=your_admin_or_staff_role_id_here

# [OPTIONAL] Enable verbose debug logging
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────
# The bot uses SQLite by default (stored in /data/game.db).
# To switch to PostgreSQL for production:
#   1. Run src/database/pg-schema.sql against your PostgreSQL instance
#   2. Set DATABASE_URL below
#   3. The bot will warn you at startup — full pg adapter instructions are in pg-schema.sql
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname
